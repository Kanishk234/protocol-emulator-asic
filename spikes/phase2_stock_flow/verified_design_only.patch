+                r = r << 1 | (int(v) >> MISO & 1)
+                self._set(SCK, 1)
+                await ClockCycles(d.clk, H, rising=False)
+                self._set(SCK, 0)
+            reply.append(r)
+        await ClockCycles(d.clk, H, rising=False)
+        self._set(CSN, 1)
+        await ClockCycles(d.clk, 2 * H, rising=False)
+        return bytes(reply)
