# Volatile 256-byte I2C memory target, 24xx02-style addressing and 8-byte page wrap.
# SDA=uio0, SCL=uio1, no clock stretching. L0 handles wire timing; L1 owns SRAM.
# Writes commit immediately, not at STOP; no write-cycle busy time or nonvolatile retention.
# Start from the supplied 0xFF image. Host SRAM changes require reloading the cached pointer.
program i2c_target_eeprom
param ADDR = 0x50
const LEN8 = 0x7000

pin U0: pin_a=uio0 pin_b=uio1 order=msb od=true idle=1 rxmode=linked_rx rx_edge=rise rx_nbits=8 rx_nbits2=1 rx_echo=false ev_edge=both ev_qual=1 ev_reset=true txmode=shift tx_edge=fall tx_lentok=true
own uio0 U0
connect L0.I0 <- U0.rx
connect L0.I1 <- L1.O0
connect U0.tx <- L0.O0
connect L1.I1 <- L0.O1

# A byte occupies one SRAM word; routines and the entry table remain outside this region.
table MEMORY:
    0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF
    0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF
    0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF
    0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF
    0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF
    0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF
    0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF
    0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF
    0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF
    0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF
    0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF
    0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF
    0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF
    0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF
    0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF
    0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF
    0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF
    0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF
    0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF
    0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF
    0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF
    0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF
    0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF
    0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF
    0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF
    0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF
    0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF
    0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF
    0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF
    0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF
    0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF
    0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF

lane L0:
    K0 = 0x00FE
    K1 = ADDR << 1
    K2 = LEN8
    states IDLE ADDR ACKQ RW XFER FWD RT
    # Preserve transaction order on the memory-service channel.
    slot urgent: when I0 is EVENT, head15 == 0       do MOV O1 <- I0, deq, keep                then ADDR
    slot urgent: when I0 is EVENT, head15 == 1       do MOV O1 <- I0, deq, keep                then IDLE
    slot urgent: when ADDR, I0 is DATA              do CMPM none <- I0, mask K0 val K1 -> f0  then ACKQ
    slot urgent: when ACKQ, f0 == 1                 do MOVB O0 <- I0, 0                       then RW
    slot urgent: when ACKQ, f0 == 0                 do MOV none <- I0, deq                    then IDLE
    # Forward direction (0=write, 1=read); f1 is the zero result, hence write=1.
    slot urgent: when RW                            do AND O1 <- I0, 1, deq -> f1             then XFER
    slot urgent: when XFER, f1 == 1, I0 is DATA     do MOVB O0 <- I0, 0                       then FWD
    slot:        when FWD                           do MOV O1 <- I0, deq                      then XFER
    slot urgent: when XFER, f1 == 0                 do OR O0 <- I1, K2, deq                   then RT
    slot urgent: when RT, I0 is DATA, head0 == 0    do MOV O1 <- I0, deq                      then XFER
    slot urgent: when RT, I0 is DATA, head0 == 1    do MOV O1 <- I0, deq                      then IDLE
    slot:        when IDLE, I0 is DATA              do MOV none <- I0, deq

lane L1:
    r0 = 0                              # current address
    r1 = 0xFF                           # cached MEMORY[r0], matching the initial image
    states M_IDLE M_DIR M_PTR M_REFRESH M_WRITE M_STORE M_ADVANCE M_WAIT
    slot urgent: when rb == 0, I1 is EVENT, head15 == 0  do MOV none <- I1, deq           then M_DIR
    slot urgent: when rb == 0, I1 is EVENT, head15 == 1  do MOV none <- I1, deq           then M_IDLE
    slot: when M_DIR, I1 is DATA, head0 == 0             do MOV none <- I1, deq           then M_PTR
    # Read replies use the cache, never a new SRAM access on the first-bit deadline.
    slot: when M_DIR, I1 is DATA, head0 == 1             do MOVB O0 <- I1, r1, deq        then M_ADVANCE
    slot: when M_PTR, I1 is DATA                        do MOV r0 <- I1, deq             then M_REFRESH
    slot: when M_REFRESH                               do CALL refresh                  then M_WRITE
    slot: when M_WRITE, rb == 0, I1 is DATA             do MOV r3 <- I1, deq             then M_STORE
    slot: when M_STORE                                 do CALL store_byte               then M_WRITE
    slot: when M_ADVANCE                               do CALL advance_read             then M_WAIT
    slot: when M_WAIT, rb == 0, I1 is DATA, head0 == 0   do MOVB O0 <- I1, r1, deq        then M_ADVANCE
    slot: when M_WAIT, rb == 0, I1 is DATA, head0 == 1   do MOV none <- I1, deq           then M_IDLE

routine refresh:
    ld r1, r0, MEMORY
    ret

routine store_byte:
    st r3, r0, MEMORY
    # Increment within the current eight-byte page, not across the page boundary.
    and r2, r0, 7
    add r2, r2, 1
    and r2, r2, 7
    load16 r3, 0xF8
    and r0, r0, r3
    or r0, r0, r2
    ld r1, r0, MEMORY
    ret

routine advance_read:
    add r0, r0, 1
    load16 r2, 0xFF
    and r0, r0, r2
    ld r1, r0, MEMORY
    ret
