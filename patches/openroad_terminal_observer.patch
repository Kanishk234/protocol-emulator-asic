+// Separate schema: preserve raw access sentinels; never fabricate a via range.
+void FastRouteCore::exportNativeTerminalState(std::ostream& out) const
+{
+  if (x_grid_ < 2 || y_grid_ < 2 || num_layers_ <= 0
+      || sttrees_.size() != nets_.size()) {
+    throw std::runtime_error("Invalid native terminal dimensions/census");
+  }
+  out << "NATIVE_GRID\t" << x_grid_ << '\t' << y_grid_ << '\t' << num_layers_
+      << '\t' << x_corner_ << '\t' << y_corner_ << '\t' << tile_size_ << '\n';
+  size_t live = 0;
+  size_t nodes = 0;
+  size_t mappings = 0;
+  for (size_t id = 0; id < nets_.size(); ++id) {
+    const FrNet* net = nets_[id];
+    if (net == nullptr) {
+      out << "NATIVE_EMPTY_SLOT\t" << id << '\n';
+      continue;
+    }
+    const auto mapping = db_net_id_map_.find(net->getDbNet());
+    if (net->getDbNet() == nullptr || mapping == db_net_id_map_.end()
+        || mapping->second != static_cast<int>(id)
+        || net->getNumPins() < 0
+        || static_cast<size_t>(net->getNumPins()) != net->getPinX().size()
+        || net->getPinX().size() != net->getPinY().size()
+        || net->getPinX().size() != net->getPinL().size()) {
+      throw std::runtime_error("Inconsistent native terminal identity/pins");
+    }
+    const std::string name = net->getName();
+    if (name.empty() || name.find_first_of("\t\r\n") != std::string::npos) {
+      throw std::runtime_error("Native terminal net name cannot be encoded");
+    }
+    const auto& tree = sttrees_[id];
+    // layerAssignment initializes alias/access fields for every node of each
+    // routed tree. Local/unrouted empty/degenerate trees have no such promise.
+    // Never inspect potentially uninitialized stackAlias/assigned fields there.
+    const bool access_supported = is_3d_step_ && net->getNumPins() >= 2
+                                  && tree.num_terminals >= 2
+                                  && !tree.nodes.empty() && !tree.edges.empty();
+    out << "NATIVE_NET\t" << id << '\t' << net->getDbNet()->getId() << '\t'
+        << name << '\t' << net->getNumPins() << '\t' << net->getMinLayer()
+        << '\t' << net->getMaxLayer() << '\t' << net->getDriverIdx()
+        << '\t' << tree.num_terminals << '\t' << tree.nodes.size()
+        << '\t' << tree.edges.size() << '\t' << tree.node_to_pin_idx.size()
+        << '\n';
+    out << "TREE_ACCESS_SUPPORTED\t" << id << '\t' << access_supported << '\n';
+    for (int p = 0; p < net->getNumPins(); ++p) {
+      out << "NATIVE_PIN\t" << id << '\t' << p << '\t' << net->getPinX(p)
+          << '\t' << net->getPinY(p) << '\t' << net->getPinL(p) << '\n';
+    }
+    for (size_t n = 0; n < tree.nodes.size(); ++n) {
+      if (!access_supported) {
+        out << "NODE_UNSUPPORTED\t" << id << '\t' << n
+            << "\tno_initialized_routed_tree_access_contract\n";
+        ++nodes;
+        continue;
+      }
+      const auto& node = tree.nodes[n];
+      out << "NODE\t" << id << '\t' << n << '\t'
+          << static_cast<int>(node.x) << '\t' << static_cast<int>(node.y)
+          << '\t' << node.stackAlias << '\t' << static_cast<int>(node.botL)
+          << '\t' << static_cast<int>(node.topL) << '\t' << node.hID
+          << '\t' << node.lID << '\n';
+      int low = std::numeric_limits<int16_t>::max();
+      int high = -1;
+      size_t matches = 0;
+      // Exact getViaStackRange matching, independently reading const state.
+      for (int p = 0; p < net->getNumPins(); ++p) {
+        if (net->getPinX(p) == node.x && net->getPinY(p) == node.y) {
+          low = std::min(low, net->getPinL(p));
+          high = std::max(high, net->getPinL(p));
+          ++matches;
+        }
+      }
+      out << "VIA_RANGE\t" << id << '\t' << n << '\t' << low << '\t'
+          << high << '\t' << matches << '\n';
+      ++nodes;
+    }
+    for (const auto& [node, pin] : tree.node_to_pin_idx) {
+      out << "NODE_PIN\t" << id << '\t' << node << '\t' << pin << '\n';
+      ++mappings;
+    }
+    ++live;
+  }
+  out << "NATIVE_COMPLETE\t" << nets_.size() << '\t' << live << '\t'
+      << nodes << '\t' << mappings << '\n';
+}
