# Volatile, read-only SPI memory personality: READ 03 and FAST_READ 0B.
# Mode 0: MOSI=ui0, SCK=ui1, CS_n=ui2, MISO=uio0.
# Three address bytes; 256-byte window aliases address[23:8], wraps at 256.
# Header/dummy MISO is unspecified. No program/erase/ID/status/NVM support.
# Initial qualification target: SCK <= 500 kHz (half >=50 at 50 MHz).
program spi_target_flash
pin U0: pin_a=ui0 pin_b=ui1 pin_c=ui2 c_active=0 order=msb rxmode=linked_rx rx_edge=rise rx_nbits=8 ev_pin=c ev_edge=both
pin U1: pin_a=uio0 pin_b=ui1 pin_c=ui2 c_active=0 order=msb txmode=shift tx_edge=fall tx_preload=true tx_lentok=true c_oe=true idle=1
own uio0 U1
connect L0.I0 <- U0.rx
connect U1.tx <- L0.O0

# Deterministic host-replaceable read image: ((73*i+19) ^ (i>>1)) & 255.
table DATA:
    0x13, 0x5c, 0xa4, 0xef, 0x35, 0x82, 0xca, 0x11
    0x5f, 0xa0, 0xe8, 0x33, 0x79, 0xce, 0x16, 0x5d
    0xab, 0xe4, 0x3c, 0x77, 0xcd, 0x1a, 0x52, 0xa9
    0xe7, 0x38, 0x70, 0xcb, 0x01, 0x56, 0xae, 0xe5
    0x23, 0x6c, 0xd4, 0x1f, 0x45, 0xb2, 0xfa, 0x21
    0x6f, 0xd0, 0x18, 0x43, 0x89, 0xfe, 0x26, 0x6d
    0xdb, 0x14, 0x4c, 0x87, 0xfd, 0x2a, 0x62, 0xd9
    0x17, 0x48, 0x80, 0xfb, 0x31, 0x66, 0xde, 0x15
    0x73, 0xbc, 0xc4, 0x0f, 0x55, 0xe2, 0x2a, 0x71
    0xbf, 0xc0, 0x08, 0x53, 0x99, 0x2e, 0x76, 0xbd
    0xcb, 0x04, 0x5c, 0x97, 0x2d, 0x7a, 0xb2, 0xc9
    0x07, 0x58, 0x90, 0x2b, 0x61, 0xb6, 0xce, 0x05
    0x43, 0x8c, 0x34, 0x7f, 0xa5, 0xd2, 0x1a, 0x41
    0x8f, 0x30, 0x78, 0xa3, 0xe9, 0x1e, 0x46, 0x8d
    0x3b, 0x74, 0xac, 0xe7, 0x1d, 0x4a, 0x82, 0x39
    0x77, 0xa8, 0xe0, 0x1b, 0x51, 0x86, 0x3e, 0x75
    0xd3, 0x9c, 0x64, 0x2f, 0xf5, 0x42, 0x0a, 0xd1
    0x9f, 0x60, 0x28, 0xf3, 0xb9, 0x0e, 0xd6, 0x9d
    0x6b, 0x24, 0xfc, 0xb7, 0x0d, 0xda, 0x92, 0x69
    0x27, 0xf8, 0xb0, 0x0b, 0xc1, 0x96, 0x6e, 0x25
    0xe3, 0xac, 0x14, 0xdf, 0x85, 0x72, 0x3a, 0xe1
    0xaf, 0x10, 0xd8, 0x83, 0x49, 0x3e, 0xe6, 0xad
    0x1b, 0xd4, 0x8c, 0x47, 0x3d, 0xea, 0xa2, 0x19
    0xd7, 0x88, 0x40, 0x3b, 0xf1, 0xa6, 0x1e, 0xd5
    0xb3, 0x7c, 0x04, 0xcf, 0x95, 0x22, 0xea, 0xb1
    0x7f, 0x00, 0xc8, 0x93, 0x59, 0xee, 0xb6, 0x7d
    0x0b, 0xc4, 0x9c, 0x57, 0xed, 0xba, 0x72, 0x09
    0xc7, 0x98, 0x50, 0xeb, 0xa1, 0x76, 0x0e, 0xc5
    0x83, 0x4c, 0xf4, 0xbf, 0x65, 0x12, 0xda, 0x81
    0x4f, 0xf0, 0xb8, 0x63, 0x29, 0xde, 0x86, 0x4d
    0xfb, 0xb4, 0x6c, 0x27, 0xdd, 0x8a, 0x42, 0xf9
    0xb7, 0x68, 0x20, 0xdb, 0x91, 0x46, 0xfe, 0xb5

lane L0:
    K0 = 0x00F7
    K1 = 0x0003
    K2 = 0x7000
    K3 = 0x7000                       # CTRL WAIT for B falling edge, not DATA LEN8
    states CMD CHECK AH AM AL FETCH WAIT GO READ
    # Either CS edge resets the parser. RX is gated while deselected.
    slot urgent: when I0 is EVENT                   do MOV none <- I0, deq then CMD
    slot: when CMD, I0 is DATA                      do CMPM none <- I0, mask K0 val K1 -> f0 then CHECK
    # Hold CHECK/f0=0 and drain unsupported-command bytes until the next CS edge.
    slot: when CHECK, f0 == 0, I0 is DATA            do MOV none <- I0, deq
    slot: when CHECK, f0 == 1, I0 is DATA            do AND none <- I0, 8, deq -> f1 then AH
    slot: when AH, I0 is DATA                       do MOV none <- I0, deq then AM
    slot: when AM, I0 is DATA                       do MOV none <- I0, deq then AL
    slot: when AL, I0 is DATA                       do MOV r0 <- I0, deq then FETCH
    slot: when FETCH                               do CALL fetch then WAIT
    slot: when WAIT, rb == 0, f1 == 1               do MOVB O0 <- zero, K3, tag CTRL then GO
    slot: when WAIT, rb == 0, f1 == 0, I0 is DATA   do MOVB O0 <- I0, K3, tag CTRL, deq then GO
    slot: when GO                                  do MOV O0 <- r1 then READ
    slot: when READ, I0 is DATA                     do CALL advance <- I0, deq

routine fetch:
    ld r1, r0, DATA
    getk r2, K2
    or r1, r1, r2
    ret

routine advance:
    add r0, r0, 1
    load16 r2, 0xFF
    and r0, r0, r2
    ld r1, r0, DATA
    getk r2, K2
    or r1, r1, r2
    out O0, r1, DATA
    ret

