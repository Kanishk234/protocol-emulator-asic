# Basys 3 rev B package pins from Digilent's Basys-3-Master.xdc.
set_property PACKAGE_PIN W5 [get_ports clk100]
set_property PACKAGE_PIN U18 [get_ports reset_button]
set_property IOSTANDARD LVCMOS33 [get_ports {clk100 reset_button ja[*] jb[*] jc[*]}]
create_clock -name board_clk -period 10.000 [get_ports clk100]

set_property PACKAGE_PIN J1 [get_ports {ja[0]}]
set_property PACKAGE_PIN L2 [get_ports {ja[1]}]
set_property PACKAGE_PIN J2 [get_ports {ja[2]}]
set_property PACKAGE_PIN G2 [get_ports {ja[3]}]
set_property PACKAGE_PIN H1 [get_ports {ja[4]}]
set_property PACKAGE_PIN K2 [get_ports {ja[5]}]
set_property PACKAGE_PIN H2 [get_ports {ja[6]}]
set_property PACKAGE_PIN G3 [get_ports {ja[7]}]
set_property PACKAGE_PIN A14 [get_ports {jb[0]}]
set_property PACKAGE_PIN A16 [get_ports {jb[1]}]
set_property PACKAGE_PIN B15 [get_ports {jb[2]}]
set_property PACKAGE_PIN B16 [get_ports {jb[3]}]
set_property PACKAGE_PIN A15 [get_ports {jb[4]}]
set_property PACKAGE_PIN A17 [get_ports {jb[5]}]
set_property PACKAGE_PIN C15 [get_ports {jb[6]}]
set_property PACKAGE_PIN C16 [get_ports {jb[7]}]
set_property PACKAGE_PIN K17 [get_ports {jc[0]}]
set_property PACKAGE_PIN M18 [get_ports {jc[1]}]
set_property PACKAGE_PIN N17 [get_ports {jc[2]}]
set_property PACKAGE_PIN P18 [get_ports {jc[3]}]
set_property PACKAGE_PIN L17 [get_ports {jc[4]}]
set_property PACKAGE_PIN M19 [get_ports {jc[5]}]
set_property PACKAGE_PIN P17 [get_ports {jc[6]}]
set_property PACKAGE_PIN R18 [get_ports {jc[7]}]

set_property CONFIG_VOLTAGE 3.3 [current_design]
set_property CFGBVS VCCO [current_design]
