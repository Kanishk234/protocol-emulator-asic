@@ -60,6 +60,27 @@ pdk::ihp-sg13g2:
     PDN_HPITCH: 75.6
     PDN_HOFFSET: 13.57
 
+# WARP: CMOS5L has M1-M4 + TopMetal1 only (no Metal5/TopMetal2).
+# Power grid as in the PDK's LibreLane config: Metal4 vertical, TopMetal1 horizontal.
+pdk::ihp-sg13cmos5l:
+    # The TT CMOS5L top level routes signals only up to Metal4 (TopMetal1 = TT power grid)
+    RT_MAX_LAYER: Metal4
+    # Magic stream-out hangs on the TopMetal1 power vias (docs/BUGS.md #2); use KLayout
+    PRIMARY_GDSII_STREAMOUT_TOOL: klayout
+    FP_PDN_VERTICAL_LAYER: Metal4
+    FP_PDN_HORIZONTAL_LAYER: TopMetal1
+    PDN_MULTILAYER: True
+
+    PDN_VWIDTH: 1.0
+    PDN_VSPACING: 2.0
+    PDN_VPITCH: 50.0
+    PDN_VOFFSET: 10.0
+
+    PDN_HWIDTH: 2.0
+    PDN_HSPACING: 4.0
+    PDN_HPITCH: 50.0
+    PDN_HOFFSET: 10.0
+
 pdk::gf180mcuD:
     # Routing
     RT_MAX_LAYER: Metal4
