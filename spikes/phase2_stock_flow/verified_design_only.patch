+    def _set(self, bit, v):
+        self.ui = (self.ui | 1 << bit) if v else (self.ui & ~(1 << bit))
+        self.d.ui_in.value = self.ui
+
+    async def xfer(self, data):
+        d = self.d
+        self._set(CSN, 0)
+        await ClockCycles(d.clk, H, rising=False)
+        reply = []
+        for byte in data:
+            r = 0
+            for i in range(7, -1, -1):
+                self._set(MOSI, byte >> i & 1)
