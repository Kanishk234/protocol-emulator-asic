# CAN 2.0A controller (11-bit IDs, classic frames). 2 lanes: 11 + 10 slots, 3 routines, 1 pin unit.
#   TXD = uo0, RXD = ui0 (a CAN transceiver). The pin unit does the bit-level work with general
#   BITSYNC features (D-023): recovered bit clock with resync, bit stuffing, CRC-15, readback.
# Host -> chip: EVENT dlc (0..8), DATA id, then dlc DATA bytes: send a frame (retry is the host's).
#   Push a frame's tokens together: after a lost arbitration the rest are drained, not sent.
# Chip -> host (every frame on the bus, ours included):
#   DATA w0 = SOF + ID (12 bits), DATA w1 = RTR IDE r0 DLC + 5 data bits, more DATA 12-bit words,
#   then EVENT = the last partial word if the CRC is good (we ACK it), or ERR 0x0nnn if it is bad;
#   ERR 0x1nnn = stuff error at line bit nnn.
#   For our own frame: EVENT 0x9001 = started, then 0xA000 | bit << 1 = ACKed, 0xE000 | bit << 1 =
#   no ACK, or 0x8000 | bit << 1 = lost arbitration / bit error (abort). Words: MSB first, destuffed.
# While our frame waits for the bus, only its first token is in the pin unit, so L0's output is
# never blocked and the FRAME / ACK commands for other nodes' frames always get through.
program can
param PERIOD = 50                       # bit time in clocks (50 = 1 Mbit/s)
const SYNC = 0x5000
const LEN8 = 0x7000
const LEN12 = 0xB000
const LEN7 = 0x6000
const FRAME_NEXT = 0x9800
const FRAME_NOW = 0x9000
const LINE_TX = 0xA005                  # readback: abort; stuffing on
const LINE_CRC = 0xA00D                 # ... then append the CRC
const LINE_OFF = 0xA000
const LINE_REPORT = 0xA002              # readback: report (the ACK slot)
const ACK = 0xA010                      # LINE override: dominant for one bit (the ACK slot)

pin U0: pin_a=uo0 pin_s=ui0 txmode=bitsync rxmode=bitsync period=PERIOD sampleofs=0.75 sjw=PERIOD/8 idle=1 idle_bits=11 order=msb tx_lentok=true rx_nbits=12 stuff_n=5 crc_width=15 crc_poly=0x4599
own uo0 U0
connect L0.I0 <- HOST_IN
connect L0.I1 <- L1.O0
connect U0.tx <- L0.O0
connect L1.I0 <- U0.rx
connect L1.I1 <- L0.O1
connect HOST_OUT <- L1.O1

# L0: transmit, and the only writer of U0's command stream.
lane L0:
    K0 = LEN8
    states IDLE S1 S2 WS C S3 S4 T
    slot: when IDLE, f2 == 0, rb == 0, I0 is EVENT     do MOV r0 <- I0, deq                then S1   # dlc
    slot: when S1, I0 is DATA                          do MOV r1 <- I0, deq                then S2   # id
    slot: when S2, rb == 0                             do CALL txhdr                       then WS
    slot: when WS, I1 is EVENT, head0 == 1             do MOV O1 <- I1, deq, keep          then C    # started -> host
    slot: when C                                       do MOV O0 <- r3                     then S3   # RTR IDE r0 DLC
    slot: when S3, rb == 0, f0 == 0, I0 is DATA        do OR O0 <- I0, K0, deq             then S4   # data byte
    slot: when S4                                      do SUB r2 <- r2, 1 -> f0            then S3
    slot: when S3, rb == 0, f0 == 1                    do CALL txtail                      then T
    slot: when T, rb == 0                              do MOV none <- zero                 then IDLE
    # the TX result (ACK / no ACK / abort) ends "transmitting" (f2) at once, even mid-frame
    slot: when I1 is EVENT, head0 == 0                 do MOV O1 <- I1, deq, keep -> f2
    # FRAME and ACK from L1: both are unit commands that bypass the TX queue (the unit ignores
    # an ACK override in a frame it transmits itself)
    slot: when I1 is CTRL                              do MOV O0 <- I1, deq, keep

# L1: receive (every frame, ours included), ask L0 for FRAME length and ACK, report to the host.
lane L1:
    K0 = ACK
    states W0 W1 W2 W3 W4 W5
    slot: when I0 is ERR                               do MOV O1 <- I0, deq, keep          then W0
    slot: when I0 is EVENT, head15 == 1                do MOV O0 <- I0, deq, keep                    # readback -> L0
    slot: when I1 is EVENT                             do MOV O1 <- I1, deq, keep                    # TX result -> host
    slot: when W0, I0 is DATA                          do MOV O1 <- I0, deq                then W1   # SOF + ID
    slot: when W1, I0 is DATA                          do EXT r0 <- I0, f=0x35             then W2   # DLC
    slot: when W2                                      do MOV O1 <- I0, deq                then W3
    slot: when W3, rb == 0                             do CALL frame                       then W4
    slot: when W4, I0 is DATA                          do MOV O1 <- I0, deq
    slot: when W4, I0 is EVENT, head15 == 0            do MOV O1 <- I0, deq, keep          then W5   # CRC good
    slot: when W5                                      do MOVB O0 <- zero, K0, tag CTRL    then W0   # ACK it

routine frame:                          # FRAME = 19 + 8 * min(dlc, 8) + 15 destuffed bits
    ltu r3, r0, 9
    br ok if rz
    ldi r0, 8
  ok:
    shl r1, r0, 3
    add r1, r1, 34
    load16 r2, FRAME_NOW
    or r1, r1, r2
    out O0, r1, CTRL
    ret

routine txhdr:                          # r0 = dlc, r1 = id
    load16 r3, SYNC
    out O0, r3, CTRL
    ltu r3, r0, 9
    br ok if rz
    ldi r0, 8
  ok:
    shl r2, r0, 3
    add r2, r2, 34
    load16 r3, FRAME_NEXT
    or r2, r2, r3
    out O0, r2, CTRL
    load16 r3, LINE_TX
    out O0, r3, CTRL
    load16 r3, LEN12                    # SOF (0) + 11-bit ID
    or r1, r1, r3
    out O0, r1, DATA
    load16 r3, LEN7                     # RTR, IDE, r0 (all 0) + DLC: sent once the frame starts
    or r3, r3, r0
    add r2, r0, 0                       # bytes to send; f0 = none
    cpyf 0
    setf 2                              # transmitting
    ret

routine txtail:                         # CRC, then CRC delimiter, ACK slot (reported), ACK delimiter + EOF
    load16 r3, LINE_CRC
    out O0, r3, CTRL
    load16 r3, LINE_OFF
    out O0, r3, CTRL
    ldi r3, 1
    out O0, r3, DATA
    load16 r3, LINE_REPORT
    out O0, r3, CTRL
    ldi r3, 1
    out O0, r3, DATA
    load16 r3, LINE_OFF
    out O0, r3, CTRL
    load16 r3, LEN8 | 0xFF
    out O0, r3, DATA
    ret
