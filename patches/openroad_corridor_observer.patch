 // REVIEW-ONLY WARP experiment, pinned upstream dcf36133. No physical edits.
+// WARP explicit observer only. No routing, placement, cost or grid setters.
+void GlobalRouter::exportNativeCorridorState()
+{
+  const char* dir = std::getenv("WARP_CORRIDOR_DIR");
+  if (dir == nullptr || dir[0] == '\0' || force_reroute_mode_
+      || is_incremental_ || grouter_cbk_ != nullptr
+      || !dirty_nets_.empty() || !initialized_
+      || routes_.empty() || use_cugr_ || haveDetailedRoutes()) {
+    throw std::runtime_error("Native corridor observer requires explicit directory and idle initialized global routes");
+  }
+  const std::string path = std::string(dir) + "/native-corridor.tsv";
+  // Serialize before creating the final artifact; failed export leaves no file.
+  std::ostringstream out;
+  fastroute_->exportNativeCorridorState(out);
+  if (!out) {
+    throw std::runtime_error("Incomplete native corridor serialization");
+  }
+  const std::string bytes = out.str();
+  // Linux hosted worker: atomic exclusive creation, including dangling symlinks.
+  const int fd = ::open(path.c_str(), O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW,
+                        0600);
+  if (fd < 0) {
+    throw std::runtime_error("Cannot exclusively create native corridor output");
+  }
+  size_t offset = 0;
+  while (offset < bytes.size()) {
+    const size_t remaining = bytes.size() - offset;
+    const size_t chunk = remaining < 1048576 ? remaining : 1048576;
+    const ssize_t written = ::write(fd, bytes.data() + offset, chunk);
+    if (written < 0 && errno == EINTR) {
+      continue;
+    }
+    if (written <= 0) {
+      // Preserve partial artifact for diagnosis, but emit no success witness.
+      const int close_status = ::close(fd);
+      if (close_status != 0) {
+        throw std::runtime_error("Native corridor write and close failed");
+      }
+      throw std::runtime_error("Incomplete native corridor output write");
+    }
+    offset += static_cast<size_t>(written);
+  }
+  if (::close(fd) != 0) {
+    throw std::runtime_error("Cannot close native corridor observer output");
+  }
+  logger_->report("WARP_NATIVE_CORRIDOR_COMPLETE path={}", path);
+}
