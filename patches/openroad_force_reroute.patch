+// REVIEW-ONLY WARP experiment, pinned upstream dcf36133. No physical edits.
+void GlobalRouter::forceRerouteNets(const std::vector<odb::dbNet*>& nets)
+{
+  if (force_reroute_mode_ || grouter_cbk_ != nullptr || !dirty_nets_.empty()
+      || !initialized_ || routes_.empty() || use_cugr_ || allow_congestion_
+      || haveDetailedRoutes() || nets.empty() || nets.size() > 2) {
+    throw std::runtime_error("Force reroute requires idle initialized FastRoute "
+                             "global routes, no detailed wires, and 1-2 nets");
+  }
+  std::set<odb::dbNet*> selected;
+  for (odb::dbNet* db_net : nets) {
+    const auto it = db_net_map_.find(db_net);
+    if (db_net == nullptr || it == db_net_map_.end() || it->second == nullptr
+        || db_net->isSpecial() || db_net->getSigType().isSupply()
+        || db_net->getSigType() == odb::dbSigType::CLOCK
+        || db_net->getBlock() != block_ || it->second->isClockNet()
+        || it->second->isMergedNet() || it->second->isLocal()
+        || it->second->getNumPins() < 2
+        || routes_.find(db_net) == routes_.end()
+        || routes_.at(db_net).empty() || !selected.insert(db_net).second) {
+      throw std::runtime_error("Invalid/duplicate force-reroute signal net");
+    }
+  }
+  const bool old_incremental = is_incremental_;
+  const float old_critical = fastroute_->getCriticalNetsPercentage();
+  auto cleanup = [&]() {
+    if (grouter_cbk_ != nullptr) {
+      grouter_cbk_->removeOwner();
+      delete grouter_cbk_;
+      grouter_cbk_ = nullptr;
+    }
+    fastroute_->setIncrementalGrt(false);
+    fastroute_->setCriticalNetsPercentage(old_critical);
+    fastroute_->setCongestionReportIterStep(congestion_report_iter_step_);
+    forced_reroute_nets_.clear();
+    force_reroute_mode_ = false;
+    is_incremental_ = old_incremental;
+  };
+  force_reroute_mode_ = true;
+  forced_reroute_nets_ = selected;
+  try {
+    startIncremental();
+    for (odb::dbNet* db_net : selected) {
+      addDirtyNet(db_net);
+    }
+    endIncremental(true);
+  } catch (...) {
+    cleanup();
+    // Routing state is not transactional. Discard this process on any error.
+    throw;
+  }
+  cleanup();
+}
