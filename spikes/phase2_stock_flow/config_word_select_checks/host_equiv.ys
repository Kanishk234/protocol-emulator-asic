read_verilog -formal -Isrc gold_spi.v gold_host.v
hierarchy -top gold_host -chparam NL @NL@ -chparam NU @NU@ -chparam NC @NC@
proc
flatten
memory
opt
rename gold_host gold
design -stash gold
read_verilog -formal -Isrc src/trw_spi.v src/trw_host.v
hierarchy -top trw_host -chparam NL @NL@ -chparam NU @NU@ -chparam NC @NC@
proc
flatten
memory
opt
rename trw_host gate
design -stash gate
design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
equiv_make gold gate equiv
hierarchy -top equiv
equiv_simple
equiv_induct -seq 2
equiv_status -assert
