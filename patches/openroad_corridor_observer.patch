+// Read-only WARP export, BSD-3-Clause under the upstream file license.
+// Tree-step rows preserve multiplicity; they are NOT an accepted usage ledger
+// until an independent auditor reconciles every raw 3D edge against them.
+void FastRouteCore::exportNativeCorridorState(std::ostream& out) const
+{
+  if (x_grid_ < 2 || y_grid_ < 2 || num_layers_ <= 0
+      || sttrees_.size() != nets_.size()) {
+    throw std::runtime_error("Native corridor state has invalid dimensions/census");
+  }
+  out << "SCHEMA\twarp-native-corridor-v1\n"
+      << "INDEXING\tzero_based_fast_route_layers_and_grid\n"
+      << "MODEL_GATE\tusage_ledger_verified\tfalse\n"
+      << "VIA_MODEL\tglobal_route_steps_only_no_physical_cut_capacity\n"
+      << "GRID\t" << x_grid_ << '\t' << y_grid_ << '\t' << num_layers_
+      << '\t' << x_corner_ << '\t' << y_corner_ << '\t' << tile_size_ << '\n';
+  auto emit_edge = [&](const char direction, int l, int x, int y,
+                       const Edge3D& edge) {
+    out << "EDGE\t" << direction << '\t' << l << '\t' << x << '\t' << y
+        << '\t' << static_cast<int64_t>(edge.cap)
+        << '\t' << static_cast<int64_t>(edge.usage)
+        << '\t' << static_cast<int64_t>(edge.red)
+        << '\t' << static_cast<int64_t>(edge.real_cap) << '\n';
+  };
+  for (int l = 0; l < num_layers_; ++l) {
+    for (int y = 0; y < y_grid_; ++y) {
+      for (int x = 0; x < x_grid_ - 1; ++x) {
+        emit_edge('H', l, x, y, h_edges_3D_[l][y][x]);
+      }
+    }
+    for (int y = 0; y < y_grid_ - 1; ++y) {
+      for (int x = 0; x < x_grid_; ++x) {
+        emit_edge('V', l, x, y, v_edges_3D_[l][y][x]);
+      }
+    }
+  }
+  size_t exported_nets = 0;
+  size_t exported_steps = 0;
+  for (size_t id = 0; id < nets_.size(); ++id) {
+    FrNet* net = nets_[id];
+    if (net == nullptr) {
+      out << "EMPTY_SLOT\t" << id << '\n';
+      continue;
+    }
+    odb::dbNet* db_net = net->getDbNet();
+    const auto mapping = db_net_id_map_.find(db_net);
+    if (db_net == nullptr || mapping == db_net_id_map_.end()
+        || mapping->second != static_cast<int>(id)) {
+      throw std::runtime_error("Native corridor net mapping is inconsistent");
+    }
+    const std::string name = net->getName();
+    if (name.find_first_of("\t\r\n") != std::string::npos) {
+      throw std::runtime_error("Native corridor net name cannot be encoded");
+    }
+    ++exported_nets;
+    out << "NET\t" << id << '\t' << db_net->getId() << '\t' << name
+        << '\t' << net->isClock() << '\t' << net->isSoftNDR()
+        << '\t' << static_cast<int>(net->getEdgeCost())
+        << '\t' << net->getMinLayer() << '\t' << net->getMaxLayer()
+        << '\t' << net->getDriverIdx() << '\t' << net->getNumPins() << '\n';
+    for (int l = 0; l < num_layers_; ++l) {
+      out << "DEMAND\t" << id << '\t' << l << '\t'
+          << static_cast<int>(net->getLayerEdgeCost(l)) << '\n';
+    }
+    for (int p = 0; p < net->getNumPins(); ++p) {
+      out << "PIN\t" << id << '\t' << p << '\t' << net->getPinX(p)
+          << '\t' << net->getPinY(p) << '\t' << net->getPinL(p) << '\n';
+    }
+    const auto& tree = sttrees_[id];
+    out << "TREE\t" << id << '\t' << tree.num_terminals << '\t'
+        << tree.nodes.size() << '\t' << tree.edges.size() << '\n';
+    for (size_t e = 0; e < tree.edges.size(); ++e) {
+      const auto& edge = tree.edges[e];
+      const auto& route = edge.route;
+      if (route.routelen < 0
+          || (route.routelen > 0
+              && route.grids.size() < static_cast<size_t>(route.routelen) + 1)) {
+        throw std::runtime_error("Native corridor tree route is incomplete");
+      }
+      out << "TREE_EDGE\t" << id << '\t' << e << '\t' << edge.len
+          << '\t' << edge.n1 << '\t' << edge.n2 << '\t' << edge.n1a
+          << '\t' << edge.n2a << '\t' << route.routelen
+          << '\t' << route.grids.size() << '\n';
+      for (int s = 0; s < route.routelen; ++s) {
+        const auto& a = route.grids[s];
+        const auto& b = route.grids[s + 1];
+        if (a.layer < 0 || a.layer >= num_layers_
+            || b.layer < 0 || b.layer >= num_layers_) {
+          throw std::runtime_error("Native corridor step layer out of bounds");
+        }
+        // Exact releaseNetResources weighting; retain nonunit/invalid geometry
+        // for downstream rejection, never expand or deduplicate these rows.
+        const int demand = a.layer == b.layer
+                               ? static_cast<int>(net->getLayerEdgeCost(a.layer))
+                               : 0;
+        out << "STEP\t" << id << '\t' << e << '\t' << s << '\t'
+            << a.x << '\t' << a.y << '\t' << a.layer << '\t'
+            << b.x << '\t' << b.y << '\t' << b.layer << '\t'
+            << demand << '\n';
+        ++exported_steps;
+      }
+    }
+  }
+  out << "COMPLETE\t" << nets_.size() << '\t' << exported_nets
+      << '\t' << exported_steps << '\n';
+}
