+def strip_unused_vias(lef_path):
+    """WARP: OpenROAD's abstract LEF starts with the generated VIA definitions of the design
+    (with 'CUTSIZE' lines). The FABulousFabric flow reads the tile size from any line containing
+    'SIZE', so drop VIA definitions that no PIN/OBS geometry uses."""
+    import re as _re
+    lines = open(lef_path).read().split("\n")
+    used = {m.group(1) for l in lines for m in [_re.match(r"^\s+VIA\s+\S+\s+\S+\s+(\S+)", l)] if m}
+    out, skip = [], None
+    for l in lines:
+        m = _re.match(r"^VIA\s+(\S+)", l)
+        if skip is None and m and m.group(1) not in used:
+            skip = m.group(1)
+            continue
+        if skip is not None:
+            if l.strip() == f"END {skip}":
+                skip = None
+            continue
+        out.append(l)
+    with open(lef_path, "w") as f:
+        f.write("\n".join(out))
+
+
