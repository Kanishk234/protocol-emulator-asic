 // Read-only WARP export, BSD-3-Clause under the upstream file license.
 // Tree-step rows preserve multiplicity; they are NOT an accepted usage ledger
 // until an independent auditor reconciles every raw 3D edge against them.
+
+// Lookup never creates map entries; -1 explicitly classifies absent native nets.
+int FastRouteCore::nativeTerminalSlot(odb::dbNet* db_net) const
+{
+  const auto it = db_net_id_map_.find(db_net);
+  if (it == db_net_id_map_.end()) {
+    return -1;
+  }
+  const int id = it->second;
+  if (id < 0 || static_cast<size_t>(id) >= nets_.size()
+      || nets_[id] == nullptr || nets_[id]->getDbNet() != db_net) {
+    throw std::runtime_error("Inconsistent native terminal membership map");
+  }
+  return id;
+}
+
+std::pair<int, std::vector<int>> FastRouteCore::nativeTerminalMatches(
+    odb::dbNet* db_net, int x, int y, int layer) const
+{
+  const int id = nativeTerminalSlot(db_net);
+  if (id < 0) {
+    return {-1, {}};
+  }
+  const FrNet* net = nets_[id];
+  if (net->getNumPins() < 0
+      || static_cast<size_t>(net->getNumPins()) != net->getPinX().size()
+      || net->getPinX().size() != net->getPinY().size()
+      || net->getPinX().size() != net->getPinL().size()) {
+    throw std::runtime_error("Inconsistent native pin coordinate vectors");
+  }
+  std::vector<int> matches;
+  for (int p = 0; p < net->getNumPins(); ++p) {
+    if (net->getPinX(p) == x && net->getPinY(p) == y
+        && net->getPinL(p) == layer) {
+      matches.push_back(p);
+    }
+  }
+  return {id, matches};
+}
