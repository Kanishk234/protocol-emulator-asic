read_verilog -formal gold_spi.v
hierarchy -top gold_spi
proc
flatten
opt
rename gold_spi gold
design -stash gold
read_verilog -formal src/trw_spi.v
hierarchy -top trw_spi
proc
flatten
opt
rename trw_spi gate
design -stash gate
design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
equiv_make gold gate equiv
hierarchy -top equiv
equiv_simple
equiv_induct -seq 2
equiv_status -assert
