+    // Align each 10-bit port-status record to a host word before indexing.
+    // Constant padding avoids a runtime multiply-by-ten/unaligned shift.
+    wire [16*NC-1:0] port_status_words;
+    genvar status_port;
+    generate for (status_port=0; status_port<NC; status_port=status_port+1) begin : g_port_status_word
+        assign port_status_words[16*status_port +: 16] = {6'd0, port_state[10*status_port +: 10]};
+    end endgenerate
+    wire [15:0] port_status_word = port_status_words[16*r_pt[3:0] +: 16];
+
     reg     uf_late, uf_ovr;                   // unit_flags word r_uf (any unit count)
     integer ku;
     always @* begin
