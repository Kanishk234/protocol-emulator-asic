# Test-only two-lane UART loop. Externally connect uo0 to ui0.
program l4_uart_loop
param BAUD = 460800
const PERIOD = 50000000 / BAUD
pin U0: pin_a=uo0 txmode=shift nbits=10 period=PERIOD idle=1
pin U1: pin_a=ui0 rxmode=shift_rx nbits=10 period=PERIOD idle=1
own uo0 U0
connect L0.I0 <- HOST_IN
connect U0.tx <- L0.O0
connect L1.I0 <- U1.rx
connect HOST_OUT <- L1.O1
lane L0:
    r1 = 0x200
    slot: when I0 is DATA do SHOR O0 <- I0, f=0x11, deq
lane L1:
    K0 = 0x201
    K1 = 0x200
    states RX CHK
    slot: when RX, I0 is DATA do CMPM none <- I0, mask K0 val K1 -> f0 then CHK
    slot: when CHK, f0 == 1 do EXT O1 <- I0, f=0x71, deq then RX
    slot: when CHK, f0 == 0 do MOV O1 <- I0, tag ERR, deq then RX
