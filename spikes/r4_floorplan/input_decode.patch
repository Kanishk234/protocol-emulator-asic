+    // Parallel decode keeps pin-index selection out of the pad data path.
+    // Pin S retains priority; invalid pin indices keep their original defaults.
+    wire s_on = (pin_s < 5'd24);
+    wire a_on = s_on || (pin_a < 5'd24);
+    wire b_on = (pin_b < 5'd24);
+    wire c_on = (pin_c < 5'd24);
+    wire [23:0] a_match, b_match, c_match;
+    genvar pad;
+    generate
+        for (pad = 0; pad < 24; pad = pad + 1) begin : g_decode
+            assign a_match[pad] = (pin_s == pad) || (!s_on && (pin_a == pad));
+            assign b_match[pad] = (pin_b == pad);
+            assign c_match[pad] = (pin_c == pad);
+        end
+    endgenerate
+    wire decoded_a_pad = |(a_match & pads);
+    wire decoded_b_pad = |(b_match & pads);
+    wire decoded_c_pad = |(c_match & pads);
 
