+# WARP: CMOS5L has M1-M4 + TopMetal1 only (no Metal5/TopMetal2).
+# Power grid as in the PDK's LibreLane config: Metal4 vertical, TopMetal1 horizontal.
+pdk::ihp-sg13cmos5l:
+    # The TT CMOS5L top level routes signals only up to Metal4 (TopMetal1 = TT power grid)
+    RT_MAX_LAYER: Metal4
+    # KLayout stream-out is the primary GDS (TT precheck uses KLayout)
+    PRIMARY_GDSII_STREAMOUT_TOOL: klayout
+    # Tiles get vertical Metal4 power stripes only; the chip top level connects to them with
+    # its own TopMetal1 grid (as Tiny FABulous does on SKY130). No Metal4->TopMetal1 vias in the
+    # tile, which Magic could not read (docs/BUGS.md #2).
+    FP_PDN_VERTICAL_LAYER: Metal4
+    FP_PDN_HORIZONTAL_LAYER: TopMetal1
+    PDN_MULTILAYER: False
+
+    # D-017: stripes on a global grid the TT chip grid can land on: 2.1 um (TT precheck minimum),
+    # pitch = half a LUT tile width. VPWR centres at fabric x = 12.00 + 109.92 k. pdngen measures
+    # the offset from the core edge (2.88 um in) to the stripe centre: 50.40 here (centre 53.28)
+    # for LUT-width and east-column tiles; tiles.py sets 9.12 (centre 12.00) for west-column tiles.
+    PDN_VWIDTH: 2.1
+    PDN_VSPACING: 2.0
+    PDN_VPITCH: 109.92
+    PDN_VOFFSET: 50.40
+
+    PDN_HWIDTH: 2.0
+    PDN_HSPACING: 4.0
+    PDN_HPITCH: 50.0
+    PDN_HOFFSET: 10.0
+
