# 1-Wire controller profiles from Analog Devices AN126. OVERDRIVE is 0 or 1.
# A peer must enter overdrive at standard speed before using the fast profile.
# Halt and reload only when idle; a standard reset exits overdrive.
#   DQ = uio0, open drain. Host: DATA byte = write it (LSB first); CTRL 0 = reset + presence
#   detect; CTRL 1 = read a byte. HOST_OUT: a 1-bit DATA word after each reset (0 = a device
#   answered with a presence pulse), and a DATA byte per read.
program onewire_master
param OVERDRIVE = 0
const LEVEL0 = 0x1000
const LEVEL1 = 0x1800
const GAP = 0x4000
const SAMPLE = 0x8000
const RXLEN1 = 0x6021                   # SETN rx: 1-bit words, framing restarts
const RXLEN8 = 0x6028                   # SETN rx: 8-bit words
const TICK = 50 - 25 * OVERDRIVE        # standard 1 us, overdrive 0.5 us
const WRITE1_LOW = 6 - 4 * OVERDRIVE
const WRITE1_HIGH = 64 - 49 * OVERDRIVE
const WRITE0_LOW = 60 - 45 * OVERDRIVE
const WRITE0_HIGH = 10 - 5 * OVERDRIVE
const READ_DELAY = 9 - 7 * OVERDRIVE
const READ_REST = 55 - 41 * OVERDRIVE
const RESET_PRE = 5 * OVERDRIVE
const RESET_LOW = 480 - 340 * OVERDRIVE
const PRESENCE_SAMPLE = 70 - 53 * OVERDRIVE
const RESET_REST = 420 - 340 * OVERDRIVE

# Overdrive writes: 0 = 7.5 us low/2.5 us recovery; 1 = 1 us low/7.5 us recovery.
# Overdrive reads: 1 us low, sample 1 us after release, then 7 us recovery.
pin U0: pin_a=uio0 od=true idle=1 presc=TICK txmode=pulse nbits=8 order=lsb rx_nbits=8 sym0_first=0 sym0_t1=WRITE0_LOW sym0_t2=WRITE0_HIGH sym1_first=0 sym1_t1=WRITE1_LOW sym1_t2=WRITE1_HIGH
own uio0 U0
connect L0.I0 <- HOST_IN
connect U0.tx <- L0.O0
connect HOST_OUT <- U0.rx

lane L0:
    K0 = LEVEL0                         # one read slot = these four commands
    K1 = LEVEL1 | WRITE1_LOW
    K2 = SAMPLE | READ_DELAY
    K3 = GAP | READ_REST
    states IDLE R0 R1 R2 R3 R4
    slot: when IDLE, rb == 0, I0 is DATA                do MOV O0 <- I0, deq                       # write a byte
    slot: when IDLE, rb == 0, I0 is CTRL, head0 == 0    do CALL reset <- I0, deq
    slot: when IDLE, rb == 0, I0 is CTRL, head0 == 1    do MOVB r0 <- I0, 8, deq -> f0            then R0
    slot: when R0, f0 == 0                              do MOVB O0 <- zero, K0, tag CTRL          then R1
    slot: when R0, f0 == 1                              do MOV none <- zero                       then IDLE
    slot: when R1                                       do MOVB O0 <- zero, K1, tag CTRL          then R2
    slot: when R2                                       do MOVB O0 <- zero, K2, tag CTRL          then R3
    slot: when R3                                       do MOVB O0 <- zero, K3, tag CTRL          then R4
    slot: when R4                                       do SUB r0 <- r0, 1 -> f0                  then R0

# The rest after the sample is 420 us, not AN126's 410: the next slot then starts 490 us after the
# release, 10 us above the tRSTH minimum (at exactly 480 us sigrok's decoder misses the edge).
routine reset:                          # OD: 2.5 us pre-gap, 70 us low, sample at 8.5 us, 40 us rest
    load16 r1, RXLEN1
    out O0, r1, CTRL
    load16 r1, LEVEL0 | RESET_PRE
    out O0, r1, CTRL
    load16 r1, LEVEL1 | RESET_LOW
    out O0, r1, CTRL
    load16 r1, SAMPLE | PRESENCE_SAMPLE
    out O0, r1, CTRL
    load16 r1, GAP | RESET_REST
    out O0, r1, CTRL
    load16 r1, RXLEN8
    out O0, r1, CTRL
    ret
