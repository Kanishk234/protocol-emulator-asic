# I2C controller: START, repeated START, STOP, writes, reads with ACK/NACK, clock stretching.
#   11 slots + 2 routines. SDA = uio0, SCL = uio1. Host commands on HOST_IN:
#     EVENT data[15]=0  START (repeated if the bus is ours)    EVENT data[15]=1  STOP
#     DATA byte         write it; the ACK bit comes back       CTRL data[0]=n    read a byte, answer ACK (0) / NACK (1)
program i2c_controller
param PERIOD = 124                      # SCL period in clocks (124 ~ 400 kHz at 50 MHz)
const LEVEL0 = 0x1000
const LEVEL1 = 0x1800
const LEN8 = 0x7000                     # DATA: 8-bit length tag
const WAIT_FALL = 0x7000                # CTRL: WAIT for a falling edge of pin B
const WAIT_RISE = 0x7001
const CLK1 = 0x3001
const CLK8 = 0x3008
const CLK9 = 0x3009
const GAP = 0x4000

# SDA: linked shift on SCL fall, LINKED_RX on SCL rise (8 + 1), START/STOP events reset framing
pin U0: pin_a=uio0 pin_b=uio1 od=true idle=1 order=msb txmode=shift tx_edge=fall tx_lentok=true rxmode=linked_rx rx_edge=rise rx_nbits=8 rx_nbits2=1 rx_echo=false ev_edge=both ev_qual=1 ev_reset=true
# SCL: clock generator that respects clock stretching; pin B = SDA for WAIT
pin U1: pin_a=uio1 pin_b=uio0 od=true idle=1 txmode=clkgen period=PERIOD stretch=true
own uio0 U0
own uio1 U1
connect L0.I0 <- HOST_IN
connect L0.I1 <- U0.rx accept=DATA      # START/STOP events are dropped at the port
connect U0.tx <- L0.O0
connect U1.tx <- L0.O1 accept=CTRL      # one output feeds SCL (commands) ...
connect HOST_OUT <- L0.O1 accept=DATA   # ... and the host (bytes, ACK bits)

lane L0:
    K0 = LEVEL0
    K1 = LEN8                           # also WAIT_FALL when sent as a CTRL token
    K2 = CLK9
    K3 = CLK8
    r0 = 1
    states IDLE START2 BUSY WR2 WACK RD1 RD2 RD3
    # START from idle: arm SCL's WAIT for the SDA fall first, then make SDA fall
    slot: when IDLE, rb == 0, I0 is EVENT, head15 == 0     do MOVB O1 <- I0, K1, tag CTRL         then START2
    slot: when START2, I0 is EVENT, head15 == 0            do MOVB O0 <- I0, K0, tag CTRL, deq    then BUSY
    # repeated START and STOP run as routines (we own SCL: nothing races a deadline)
    slot: when BUSY, rb == 0, I0 is EVENT, head15 == 0     do CALL rstart <- I0, deq
    slot: when BUSY, rb == 0, I0 is EVENT, head15 == 1     do CALL stop <- I0, deq                then IDLE
    # write a byte: 8 data bits + the target's ACK bit
    slot: when BUSY, rb == 0, I0 is DATA                   do OR O0 <- I0, K1, deq                then WR2
    slot: when WR2                                         do MOVB O1 <- zero, K2, tag CTRL       then WACK
    slot: when WACK, I1 is DATA                            do MOV O1 <- I1, deq                   then BUSY
    # read a byte: 8 clocks, byte to the host, then our ACK/NACK bit and the 9th clock
    slot: when BUSY, rb == 0, I0 is CTRL                   do MOVB O1 <- I0, K3, tag CTRL         then RD1
    slot: when RD1, I1 is DATA                             do MOV O1 <- I1, deq                   then RD2
    slot: when RD2                                         do MOV O0 <- I0, tag DATA, deq         then RD3
    slot: when RD3                                         do MKCTL O1 <- r0, f=0x30              then BUSY

routine rstart:                         # repeated START
    ldi r1, 1
    out O0, r1, DATA                    # SDA: release at the next SCL fall
    load16 r2, CLK1
    out O1, r2, CTRL                    # SCL: one clock (ends high)
    load16 r2, WAIT_FALL
    out O1, r2, CTRL                    # SCL: arm WAIT for the START edge
    load16 r2, WAIT_RISE
    out O0, r2, CTRL                    # SDA: wait for SCL high
    load16 r2, LEVEL0 | PERIOD // 2
    out O0, r2, CTRL                    # SDA falls: repeated START
    ret

routine stop:
    ldi r1, 0
    out O0, r1, DATA                    # SDA: low at the next SCL fall
    load16 r2, CLK1
    out O1, r2, CTRL
    load16 r2, WAIT_RISE
    out O0, r2, CTRL
    load16 r2, LEVEL1 | PERIOD // 2
    out O0, r2, CTRL                    # SDA rises: STOP
    load16 r2, GAP | PERIOD
    out O0, r2, CTRL                    # bus free time (tBUF) before the next START
    ret
